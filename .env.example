# Clé API Groq (gratuite) — https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_ici

# Auth.js — génère une valeur avec: npx auth secret
AUTH_SECRET=

# Ces variables sont injectées automatiquement quand tu lies
# une base "Vercel Postgres" à ton projet depuis le dashboard.
# En local, récupère-les avec: vercel env pull .env.local
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
