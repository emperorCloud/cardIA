# Clé API Groq (gratuite) — https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_ici

# Secret Auth.js — génère-le avec: npx auth secret
# ⚠️ Le nom de la variable doit être AUTH_SECRET, pas BETTER_AUTH_SECRET
# (BETTER_AUTH_SECRET appartient à une autre librairie, "Better Auth",
# qu'on n'utilise pas ici — on est sur Auth.js / NextAuth).
# Si un générateur en ligne t'a donné plusieurs lignes, prends juste la
# valeur et colle-la ici sous AUTH_SECRET.
AUTH_SECRET=

# Injectée automatiquement par l'intégration Neon sur Vercel
# (Storage > Marketplace > Neon > Connect Project).
# En local : vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Modèles Groq (optionnel — valeurs par défaut déjà à jour au 19/09/2026)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_COMPOUND_MODEL=groq/compound
