# ═══ Moteurs d'IA — ordre d'essai (une clé absente = fournisseur ignoré) ═══
# Gratuit d'abord ; Claude (payant) en premier si tu ajoutes une clé Anthropic.
LLM_PROVIDER_ORDER=anthropic,gemini,groq

# ── 1) Gemini — Google AI Studio (palier gratuit) ──
# Clé : https://aistudio.google.com/api-keys  (pas de carte bancaire)
GEMINI_API_KEY=
# Modèles essayés dans l'ordre (conversation normale)
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# Modèle utilisé quand la recherche web est activée (🌐) :
# la recherche Google gratuite (500 requêtes/jour) n'existe que sur la série 2.5.
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# ── 2) Groq — secours gratuit ──
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── 3) Claude (Anthropic) — optionnel, payant à l'usage ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# true = Jessy cherche sur le web de lui-même, sans le bouton 🌐
# (consomme le quota de recherche du fournisseur)
WEB_SEARCH_ALWAYS=false

# ── Auth.js ──
# npx auth secret  (variable AUTH_SECRET, pas BETTER_AUTH_SECRET)
AUTH_SECRET=

# ── Base de données Neon (injectée par l'intégration Vercel) ──
DATABASE_URL=
DATABASE_URL_UNPOOLED=
